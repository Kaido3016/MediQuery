# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mediquery.db
JWT_SECRET=replace-with-a-unique-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
UPLOAD_ROOT=private_uploads
MAX_REPORT_BYTES=10485760
MAX_PDF_PAGES=100
FREE_REPORT_LIMIT=3
# Optional: provider-hosted checkout URL. Leave empty until a real payment provider is configured.
BILLING_CHECKOUT_URL=
# Optional: protects /health/metrics. Use a random >=32-character secret in production.
METRICS_TOKEN=

# Production private object storage (S3-compatible); KMS key is mandatory in production.
STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ca-central-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_KMS_KEY_ID=
# Production upload scanning is fail-closed. Use a private ClamAV service.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Email verification and password recovery; use a reputable transactional SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:8501
EMAIL_TOKEN_MINUTES=30
# Stripe subscription checkout; all values are server-side secrets/config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
MFA_ISSUER=MediQuery
